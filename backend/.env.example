# ─────────────────────────────────────────────────────────────
#  BACKEND ENVIRONMENT — คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง
#  ห้าม commit ไฟล์ .env เข้า git เด็ดขาด
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# URL ของ Frontend ที่อนุญาตให้เรียก API (CORS) — คั่นด้วย comma ได้
CORS_ORIGIN=http://localhost:5173

# ─── DATABASE ────────────────────────────────────────────────
DATABASE_URL="postgresql://tcom:tcom_dev_password@localhost:5432/tcom_db?schema=public"

# ─── SESSION ─────────────────────────────────────────────────
# สร้างค่าสุ่มด้วย:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_NAME=tcom.sid
SESSION_MAX_AGE_HOURS=8

# ─── UPLOAD ──────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_MIME=image/jpeg,image/png,image/webp,image/svg+xml

# ─── BACKUP ──────────────────────────────────────────────────
BACKUP_DIR=./backups

# ─── RATE LIMIT ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5

# ─── SEED ADMIN (ใช้ครั้งแรกตอน npm run db:seed เท่านั้น) ──────
# ตั้งรหัสผ่านที่คาดเดายากอย่างน้อย 12 ตัวอักษร แล้วเปลี่ยนทันทีหลังเข้าระบบครั้งแรก
SEED_ADMIN_EMAIL=admin@tcom.rtc.ac.th
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
