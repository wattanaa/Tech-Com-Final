{
  "name": "tcom-website",
  "version": "1.0.0",
  "private": true,
  "description": "ระบบเว็บไซต์สารสนเทศ แผนกวิชาเทคโนโลยีคอมพิวเตอร์ วิทยาลัยเทคนิคร้อยเอ็ด",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:demo": "node scripts/setup.mjs --demo",
    "predev": "node scripts/setup.mjs --quick",
    "dev": "concurrently -n api,web -c blue,cyan -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "db:studio": "npm run db:studio --workspace backend",
    "db:reset": "npm run db:reset --workspace backend",
    "fresh": "npm run db:down && docker compose up -d && node scripts/setup.mjs --demo",
    "db:generate:all": "npm run db:generate --workspace backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true
  }
}
