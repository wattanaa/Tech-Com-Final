# nginx สำหรับเสิร์ฟ SPA + proxy ไป backend
# BACKEND_INTERNAL_HOST/PORT และ RESOLVER ถูกแทนค่าตอน container เริ่ม (envsubst บน *.template)
# ค่าเริ่มต้นเข้ากับ docker-compose (service name "backend" + DNS ของ Docker)
# บน Fly.io ให้ตั้ง BACKEND_INTERNAL_HOST เป็น <ชื่อแอป backend>.internal และ RESOLVER เป็น [fdaa::3]:53
server {
  listen 80;
  server_name _;

  resolver ${RESOLVER} valid=5s;

  root /usr/share/nginx/html;
  index index.html;

  # จำกัดขนาดไฟล์อัปโหลดให้สอดคล้องกับฝั่ง backend (5MB + เผื่อ header)
  client_max_body_size 6m;

  # บีบอัดไฟล์ข้อความเพื่อให้โหลดเร็วขึ้น
  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # ── ส่งต่อ API ไปยัง backend ──
  # ใช้ตัวแปร $backend_upstream แทนการเขียน host ตรง ๆ เพื่อบังคับให้ nginx re-resolve
  # ผ่าน resolver ด้านบนทุกครั้ง (จำเป็นบน Fly.io เพราะ IP ของ .internal เปลี่ยนได้เวลา redeploy)
  location /api/ {
    set $backend_upstream "${BACKEND_INTERNAL_HOST}:${BACKEND_INTERNAL_PORT}";
    proxy_pass http://$backend_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;
  }

  # ── ส่งต่อไฟล์ที่อัปโหลด (รูปภาพ) ไปยัง backend ──
  location /uploads/ {
    set $backend_upstream "${BACKEND_INTERNAL_HOST}:${BACKEND_INTERNAL_PORT}";
    proxy_pass http://$backend_upstream;
    proxy_set_header Host $host;
    expires 7d;
    add_header Cache-Control "public";
  }

  # ── cache ไฟล์ static ที่มี hash ในชื่อ ──
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # ── SPA fallback: ทุกเส้นทางที่ไม่ใช่ไฟล์จริง ให้ส่ง index.html ──
  location / {
    try_files $uri $uri/ /index.html;
  }

  # ไม่เปิดเผยเวอร์ชัน nginx
  server_tokens off;
}
